{
    "name": "romanfedorskij/cron",
    "description": "Unix cron scheduler with forked PHP workers and graceful process-group shutdown",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Roman Fedorskij",
            "email": "markaryanroma@mail.ru"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "dragonmantank/cron-expression": "^3.6",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/log": "^3.0",
        "symfony/console": "^6.4 || ^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "buggregator/trap": "^1.16.1",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "llm/skills": "^1.20",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpyh/coding-standard": "^2.6.3",
        "rector/rector": "^2.7",
        "testo/assert": "^0.1.17",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.55"
    },
    "autoload": {
        "psr-4": {
            "Wolfcharaa\\Cron\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wolfcharaa\\Cron\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/crontab-to-yaml"
    ],
    "config": {
        "allow-plugins": {
            "llm/skills": true
        },
        "lock": false,
        "sort-packages": true
    },
    "extra": {
        "skills": {
            "source": "resources/skills"
        }
    },
    "scripts": {
        "archive:check": "sh bin/check-package-archive",
        "consumer:check": "sh bin/check-consumer-example",
        "test": "testo --no-coverage"
    }
}
