#!/usr/bin/env php
<?php

declare(strict_types=1);

use Symfony\Component\Console\Application;
use Wolfcharaa\Cron\Internal\Console\CrontabToYamlCommand;

require dirname(__DIR__) . '/vendor/autoload.php';

$application = new Application('Cron migration tools');
$application->add(new CrontabToYamlCommand());
$application->setDefaultCommand('cron:crontab-to-yaml', true);

exit($application->run());
