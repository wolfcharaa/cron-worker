{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/romanfedorskij/cron/blob/main/resources/schema/crontab.schema.json",
  "title": "Cron worker configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["profiles"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "execution": {
      "type": "object",
      "not": {
        "required": ["working_directory", "cwd"]
      },
      "properties": {
        "shell": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "overlap_policy": {
          "enum": ["forbid", "allow"]
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "log": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "defaults": {
      "allOf": [
        {
          "$ref": "#/$defs/execution"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "shell": true,
            "working_directory": true,
            "cwd": true,
            "path": true,
            "environment": true,
            "overlap_policy": true,
            "user": true,
            "log": true
          }
        }
      ]
    },
    "chainTask": {
      "allOf": [
        {
          "$ref": "#/$defs/execution"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "command"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "shell": true,
            "working_directory": true,
            "cwd": true,
            "path": true,
            "environment": true,
            "overlap_policy": true,
            "user": true,
            "log": true
          }
        }
      ]
    },
    "job": {
      "allOf": [
        {
          "$ref": "#/$defs/execution"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "schedule", "command"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/chainTask"
              }
            },
            "shell": true,
            "working_directory": true,
            "cwd": true,
            "path": true,
            "environment": true,
            "overlap_policy": true,
            "user": true,
            "log": true
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs"],
      "not": {
        "required": ["working_directory", "cwd"]
      },
      "properties": {
        "description": {
          "type": "string"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "shell": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "overlap_policy": {
          "enum": ["forbid", "allow"]
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "log": {
          "type": "string",
          "minLength": 1
        },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    }
  }
}
